{
	"name": "companion-module-feelworld-l3-series",
	"version": "1.1.0",
	"description": "Companion module for Feelworld L3 Video Switcher",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"format": "prettier -w .",
		"package": "npm run build && companion-module-build",
		"build": "rimraf dist && npm run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "npm run lint:raw ."
	},
	"keywords": [
		"companion",
		"feelworld",
		"l3",
		"switcher",
		"video"
	],
	"author": "1483942430",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/1483942430/companion-module-feelworld-l3-series.git"
	},
	"bugs": {
		"url": "https://github.com/1483942430/companion-module-feelworld-l3-series/issues"
	},
	"engines": {
		"node": "^26"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^26.6.4",
		"eslint": "^10.12.0",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.18.1"
}
